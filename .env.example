# Connessione usata dall'API (ruolo senza privilegi: la Row-Level Security si applica)
DATABASE_URL=postgres://suite_app:suite_app_dev@localhost:5432/suite
# Connessione usata solo per le migrazioni (proprietario delle tabelle)
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/suite
# Cambiala con una stringa lunga e casuale
JWT_SECRET=cambia-questa-stringa-in-produzione
API_PORT=3000
WEB_ORIGIN=http://localhost:5173

# Email (solleciti). In locale arrivano a Mailpit: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="Suite PMI <noreply@suite.local>"
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=true

# PEC: in produzione l'SMTP del tuo gestore PEC (es. smtps.pec.aruba.it:465).
# In locale la mandiamo anche lei a Mailpit. Commenta PEC_SMTP_HOST per disattivarla.
PEC_SMTP_HOST=localhost
PEC_SMTP_PORT=1025
PEC_SMTP_FROM="Azienda Demo <azienda@pec.demo.it>"
# PEC_SMTP_USER=
# PEC_SMTP_PASS=
# PEC_SMTP_SECURE=true

# Sicurezza: tentativi di login/registrazione per IP al minuto
AUTH_RATE_LIMIT=10
# In produzione dietro un proxy (Railway, Render, nginx) metti true per leggere l'IP reale
TRUST_PROXY=false
